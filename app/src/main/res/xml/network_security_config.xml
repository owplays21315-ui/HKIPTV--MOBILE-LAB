<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Android requires a process-wide cleartext permission for dynamic media hosts.
         PlaybackHttpClient keeps HTTP disabled by default and validates every destination. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
